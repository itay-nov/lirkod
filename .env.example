# Copy this file to .env.local and fill in real values.
# No application code reads these yet — src/lib/db/ is still empty. The RLS test
# suite does not use them either; it reads the local stack's URL and keys straight
# from `supabase status`, so there is nothing to keep in sync by hand.

# Supabase (Postgres + PostGIS, Auth, Realtime, Storage)
# For local development, `npm run db:start` prints the values for the first two.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose this to the browser (AGENTS.md §8). It bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
